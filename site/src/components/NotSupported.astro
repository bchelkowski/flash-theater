---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---
<div class="rounded-xl border border-amber-800/40 bg-amber-950/20 p-5 my-8">
  <h3 class="text-sm font-semibold text-amber-300 uppercase tracking-wider mb-3 flex items-center gap-2">
    <span>⚠️</span> Not (yet) supported
  </h3>
  <ul class="space-y-2">
    {items.map((item) => (
      <li class="flex items-start gap-2 text-sm text-slate-300">
        <span class="text-amber-500 mt-0.5">○</span>
        <span set:html={item} />
      </li>
    ))}
  </ul>
</div>
