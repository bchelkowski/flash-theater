---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A precompiler for Roku/BrightScript/SceneGraph — declarative bindings, no hand-written observers.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en" class="antialiased">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — flash-theater</title>
  <meta name="description" content={description} />
  <meta name="og:title" content={`${title} — flash-theater`} />
  <meta name="og:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body class="bg-[#0a0e14] text-slate-100 font-[Inter,system-ui,sans-serif] min-h-screen flex flex-col">
  <header class="sticky top-0 z-50 border-b border-[#1f2c42] bg-[#0a0e14]/90 backdrop-blur-sm">
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center gap-6">
      <a href={base || '/'} class="flex items-center gap-2.5 shrink-0 group">
        <span class="text-xl">🎬</span>
        <span class="font-semibold text-white tracking-tight">flash-theater</span>
      </a>

      <div class="hidden sm:flex items-center gap-1 text-sm">
        <a href={`${base}/docs/`} class="px-3 py-1.5 rounded-md text-slate-400 hover:text-white hover:bg-white/5 transition-colors">Docs</a>
        <a href={`${base}/parser/`} class="px-3 py-1.5 rounded-md text-slate-400 hover:text-white hover:bg-white/5 transition-colors">flash-parser</a>
        <a href={`${base}/compiler/`} class="px-3 py-1.5 rounded-md text-slate-400 hover:text-white hover:bg-white/5 transition-colors">Compiler</a>
      </div>

      <div class="ml-auto flex items-center gap-1">
        <span class="hidden sm:inline text-xs px-2 py-1 rounded-full bg-amber-900/40 text-amber-300 border border-amber-700/40">Preview</span>
        <a
          href="https://github.com/bchelkowski/flash-theater"
          target="_blank"
          rel="noopener"
          class="flex items-center gap-2 px-3 py-1.5 rounded-md text-sm text-slate-400 hover:text-white hover:bg-white/5 transition-colors"
          aria-label="GitHub"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          GitHub
        </a>
      </div>
    </nav>
  </header>

  <main class="flex-1">
    <slot />
  </main>

  <footer class="border-t border-[#1f2c42] mt-20 py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="text-lg">🎬</span>
        <span class="text-sm text-slate-500">flash-theater — a Roku/BrightScript precompiler</span>
      </div>
      <p class="text-sm text-slate-600">MIT License</p>
    </div>
  </footer>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
