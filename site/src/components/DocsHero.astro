---
interface Props {
  icon: string;
  title: string;
}

const { icon, title } = Astro.props;
---
<div class="mb-8">
  <div class="text-3xl mb-3">{icon}</div>
  <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">{title}</h1>
  <p class="text-slate-400 leading-relaxed max-w-2xl">
    <slot />
  </p>
</div>
