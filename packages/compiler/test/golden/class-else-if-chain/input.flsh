class Grader {
  constructor(score: integer) {
    private score: integer = score
  }

  public function classify(): string {
    if (m.score >= 90) {
      return "A"
    } else if (m.score >= 80) {
      return "B"
    } else {
      return "C"
    }
  }

  public function sign(): integer {
    if (m.score > 0) return 1
    else if (m.score < 0) return -1
    else return 0
  }
}
