<script>
field limit: integer = 5
state total: integer = 0

private function sumTo(): integer {
  result = 0
  for (i = 0 to limit step 1) {
    result = result + i
  }
  return result
}

private function listNames(names: object): string {
  joined = ""
  for each (name in names) {
    joined = joined + name + ","
  }
  return joined
}

private function countDown() {
  i = limit
  while (i > 0) {
    print i
    i = i - 1
  }
}

private function safeDivide(a: integer, b: integer): integer {
  result = 0
  try {
    result = a / b
  } catch (e) {
    result = e.number
  }
  return result
}

public function recompute() {
  state total = sumTo()
}
</script>

<component>
<LayoutGroup id="root">
  <Label id="out" text="{total.ToStr()}" />
</LayoutGroup>
</component>
