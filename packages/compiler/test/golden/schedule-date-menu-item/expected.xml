<?xml version="1.0" encoding="utf-8" ?>
<component name="ScheduleDateMenuItem" extends="Group">
  <interface>
    <field id="width" type="integer" value="0" onChange="on_widthChange" />
    <field id="height" type="integer" value="0" onChange="on_heightChange" />
    <field id="focusPercent" type="float" value="0.0" onChange="on_focusPercentChange" />
    <field id="gridHasFocus" type="boolean" value="false" onChange="on_gridHasFocusChange" />
    <field id="itemContent" type="node" onChange="on_itemContentChange" />
    <field id="ft_routeReady" type="boolean" value="false" />
    <function name="ft_unmount" />
  </interface>
  <children>
    <Rectangle id="background" color="0x1A1A1AFF">
      <Rectangle id="highlight" />
      <LayoutGroup id="labelsContainer" horizAlignment="center" vertAlignment="center">
        <Label id="titleLabel" />
        <Label id="dayNameLabel" />
      </LayoutGroup>
    </Rectangle>
  </children>
  <script type="text/brightscript" uri="ScheduleDateMenuItem.brs" />
</component>
