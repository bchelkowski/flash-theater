<script>
field threshold: integer = 3

private function countMatches(items: object): integer {
  matches = 0
  for (i = 0 to items.Count() - 1) {
    if (items[i] > threshold) {
      matches = matches + 1
    }
  }
  return matches
}

private function findFirstOver(items: object): integer {
  found = -1
  i = 0
  while (i < items.Count()) {
    for (j = i to items.Count() - 1) {
      if (items[j] > threshold) {
        found = items[j]
      }
    }
    i = i + 1
  }
  return found
}
</script>

<component>
<LayoutGroup id="root" />
</component>
