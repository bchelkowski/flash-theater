<script>
field limit: integer = 5

' flash-theater:raw
m.top.limit = m.top.limit + 1
' flash-theater:end-raw

private function describe(): string {
  ' flash-theater:raw
  result = "limit is " + someUndeclaredHelperName().ToStr()
  ' flash-theater:end-raw
  return result
}
</script>

<component>
<LayoutGroup id="root">
  <Label id="out" text="{limit.ToStr()}" />
</LayoutGroup>
</component>
