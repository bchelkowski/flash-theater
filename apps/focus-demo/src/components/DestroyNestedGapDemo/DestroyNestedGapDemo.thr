<script>
' Chapter 6/7 — the {#if:destroy}-with-a-nested-custom-component gap, and its workaround.
' {#if:destroy}'s own generated teardown only walks THIS component's own template for focusable
' descendants to unregister before removeChild — it has no visibility into a nested custom
' component's own internal template (FocusGroup is opaque from here), so it correctly emits no
' unregister call at all for a block whose content is a nested custom component. Left alone, that
' leaves a dangling registry entry pointing at an already-destroyed node — see
' findings/focus-router-free-and-nested-gaps.md.
'
' This chapter always uses the WORKAROUND (there's no compiler diagnostic or fallback for the
' gap itself — omitting the workaround is a real, silent bug, not something safe to demonstrate
' live without risking navigate() actually crashing on a stale node reference): unregisterSubtree
' on the nested component BEFORE the state write that triggers destruction (while the subtree is
' still attached — unregister()'s own doc comment requires this ordering), then
' claimFocusIfVacant to hand focus back into the vacancy the removal just created, the same
' pattern apps/animation-demo's DestroyCustomDemo.thr already uses for its own cross-component
' unmount cascade.
state showNested: boolean = false

private function toggleNested(key: string, press: boolean) {
  if (press) {
    if (showNested) {
      m.global.ft_focus.callFunc("unregisterSubtree", m.nestedGroup)
    }
    state showNested = not showNested
    if (showNested) {
      m.global.ft_focus.callFunc("claimFocusIfVacant", m.toggle)
    }
  }
}

scale field rootWidth: integer = 1920
scale field rootHeight: integer = 1080
scale state titleTranslation: object = [40, 40]
scale state subtitleTranslation: object = [40, 90]
scale field toggleWidth: integer = 400
scale field toggleHeight: integer = 60
scale state toggleTranslation: object = [40, 160]
scale state toggleLabelInset: object = [16, 18]
scale state nestedTranslation: object = [40, 260]
</script>

<component>
<Rectangle id="root" color="0x151515FF" width="{rootWidth}" height="{rootHeight}">
  <Label id="title" text="6/7 — {#if:destroy} + a nested custom component, correctly worked around" color="0xFFFFFFFF" translation="{titleTranslation}" />
  <Label id="subtitle" text="OK toggles FocusGroup in/out — the surrounding unregisterSubtree/claimFocusIfVacant is required" color="0xAAAAAAFF" translation="{subtitleTranslation}" />
  <Rectangle id="toggle" focusable="true" default-focus="true" color="0x2A2A6AFF" width="{toggleWidth}" height="{toggleHeight}" translation="{toggleTranslation}" on:key[OK]="{toggleNested()}">
    <Label id="toggleLabel" text="OK: toggle the nested FocusGroup" color="0xFFFFFFFF" translation="{toggleLabelInset}" />
  </Rectangle>
  {#if:destroy showNested}
  <FocusGroup id="nestedGroup" translation="{nestedTranslation}" />
  {/if}
</Rectangle>
</component>
