<script>
' Chapter 6/7 — the {#if:destroy}-with-a-nested-custom-component gap. Originally demonstrated a
' manual workaround for BOTH halves of this gap; the UNREGISTER half is now fixed automatically at
' the compiler level (issues/task-manager-no-auto-cancel-on-teardown.md's own live-verification
' session incidentally reproduced this exact gap, which led to fixing it here too) — see
' findings/focus-router-free-and-nested-gaps.md. `{#if:destroy}`'s generated destroy sub now asks
' the focus manager to unregister the outgoing subtree by OWNERSHIP (a live registry walk, not
' compile-time template visibility), so it correctly reaches FocusGroup's own focusable content even
' though FocusGroup is a separate .thr file, opaque to this component's own template analysis.
'
' The RECLAIM half is still manual, deliberately (see the findings entry for why wiring it
' automatically into {#if:destroy}'s own create path would reintroduce a real, already-fixed
' ordering bug): claimFocusIfVacant hands focus back into the vacancy the automatic unregister just
' created, the same pattern apps/animation-demo's DestroyCustomDemo.thr already uses for its own
' cross-component unmount cascade.
state showNested: boolean = false

private function toggleNested(key: string, press: boolean) {
  if (press) {
    state showNested = not showNested
    if (showNested) {
      m.global.ft_focus.callFunc("claimFocusIfVacant", m.toggle)
    }
  }
}

scale field rootWidth: integer = 1920
scale field rootHeight: integer = 1080
scale state titleTranslation: object = [40, 40]
scale state subtitleTranslation: object = [40, 90]
scale field toggleWidth: integer = 400
scale field toggleHeight: integer = 60
scale state toggleTranslation: object = [40, 160]
scale state toggleLabelInset: object = [16, 18]
scale state nestedTranslation: object = [40, 260]
</script>

<component>
<Rectangle id="root" color="0x151515FF" width="{rootWidth}" height="{rootHeight}">
  <Label id="title" text="6/7 — {#if:destroy} + a nested custom component" color="0xFFFFFFFF" translation="{titleTranslation}" />
  <Label id="subtitle" text="OK toggles FocusGroup in/out — unregister is automatic now, claimFocusIfVacant on entry is still required" color="0xAAAAAAFF" translation="{subtitleTranslation}" />
  <Rectangle id="toggle" focusable="true" default-focus="true" color="0x2A2A6AFF" width="{toggleWidth}" height="{toggleHeight}" translation="{toggleTranslation}" on:key[OK]="{toggleNested()}">
    <Label id="toggleLabel" text="OK: toggle the nested FocusGroup" color="0xFFFFFFFF" translation="{toggleLabelInset}" />
  </Rectangle>
  {#if:destroy showNested}
  <FocusGroup id="nestedGroup" translation="{nestedTranslation}" />
  {/if}
</Rectangle>
</component>
