<script>
' This app's root Scene, compiled from .thr (like every other chapter app's — see
' apps/animation-demo/src/components/MainScene.thr for the pattern this copies). Router-mounted
' chapters, one per taskManager mechanism from site/src/pages/docs/task-manager.astro — see
' findings/demo-app-conventions.md for why every demo app now uses `router`+`scale` instead of the
' old {#if:destroy}/manual-focus-claim switching apps/async-demo (this app's un-split predecessor)
' still uses. `router.navigate()`'s own default-focus proposal+claim and per-navigation vacuum
' supersede that bookkeeping entirely — this file has no `claimFocusIfVacant`/`unregisterSubtree`
' calls anywhere, unlike apps/async-demo/src/components/MainScene.thr's own ~70-line version.
'
' `taskManager.onRequestSent(...)`/`onResponseReceived(...)` (see GRAMMAR.md's "Task manager"
' section) are registered ONCE, here — the persistent readout below stays visible across every
' chapter switch, proving the "global, register-once, fires for ANY request/response anywhere in
' the app" design. Only chapter 4 (/interceptors, InterceptorsDemo) ever actually issues a request
' (via its own GetPost.thr component), but the readout deliberately lives here in MainScene, not
' inside that chapter — mirroring apps/async-demo/src/components/MainScene.thr's own
' onAnyRequestSent/onAnyResponseReceived (the one piece of that file worth carrying forward — see
' findings/task-manager-demo-app.md for the full writeup).
scale field rootWidth: integer = 1280
scale field rootHeight: integer = 720
scale state hintTranslation: object = [40, 630]
scale state requestReadoutTranslation: object = [40, 662]
scale state responseReadoutTranslation: object = [40, 690]

field chapterPaths: array = [
  "run-cancel", "alerting", "on-result", "interceptors"
]
state activeChapterIndex: integer = 0

state lastRequestSentText: string = "onRequestSent: (none yet)"
state lastResponseReceivedText: string = "onResponseReceived: (none yet)"

derived hintText: string = "Chapter " + (activeChapterIndex + 1).ToStr() + "/4 — REWIND / FAST-FORWARD to switch, BACK to return"

private function onAnyRequestSent(req: dynamic) {
  status = "OK"
  if (not req.buildSucceeded) {
    status = "FAILED - " + req.buildErrorMessage
  }
  state lastRequestSentText = "onRequestSent: " + req.url + "  [build: " + status + "]"
}

private function onAnyResponseReceived(resp: dynamic) {
  status = "OK"
  if (not resp.parseSucceeded) {
    status = "FAILED - " + resp.parseErrorMessage
  }
  state lastResponseReceivedText = "onResponseReceived: HTTP " + resp.httpStatusCode.ToStr() + "  [parse: " + status + "]"
}

private function nextChapter(key: string, press: boolean) {
  if (press and activeChapterIndex < chapterPaths.Count() - 1) {
    state activeChapterIndex = activeChapterIndex + 1
    router.navigate("/" + chapterPaths[activeChapterIndex])
  }
}

private function prevChapter(key: string, press: boolean) {
  if (press and activeChapterIndex > 0) {
    state activeChapterIndex = activeChapterIndex - 1
    router.navigate("/" + chapterPaths[activeChapterIndex])
  }
}

public function setup() {
  taskManager.onRequestSent(onAnyRequestSent)
  taskManager.onResponseReceived(onAnyResponseReceived)
  router.setRouting([
    { path: "run-cancel", component: "RunCancelDemo" },
    { path: "alerting", component: "AlertingChapterDemo" },
    { path: "on-result", component: "OnResultDemo" },
    { path: "interceptors", component: "InterceptorsDemo" }
  ])
  router.navigate("/" + chapterPaths[0])
}
</script>

<component extends="Scene" on:key[fastforward]="{nextChapter()}" on:key[rewind]="{prevChapter()}">
<Rectangle id="root" color="0x101010FF" width="{rootWidth}" height="{rootHeight}">
  <FlashTheaterRouterOutlet id="outlet" width="{rootWidth}" height="{rootHeight}" />
  <Label id="hint" text="{hintText}" color="0x888888FF" translation="{hintTranslation}" />
  <Label id="requestReadout" text="{lastRequestSentText}" color="0x66CCFFFF" translation="{requestReadoutTranslation}" />
  <Label id="responseReadout" text="{lastResponseReceivedText}" color="0x66CCFFFF" translation="{responseReadoutTranslation}" />
</Rectangle>
</component>
