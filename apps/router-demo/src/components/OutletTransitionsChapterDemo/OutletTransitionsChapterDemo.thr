<script>
' Chapter 3/4 — the narrated version of what's already been happening on every chapter switch in
' this app. MainScene.thr's own <FlashTheaterRouterOutlet> carries navigate-out:/navigate-in:/
' back-out:/back-in:, all targeting the outlet itself (never a chapter screen — a routed screen has
' no compile-time id an animation could reference). Router-outlet transitions have no per-route
' override (GRAMMAR.md's own "Not supported" list) — they're configured once, on the outlet, and
' apply to EVERY route it ever mounts, this screen included. See GRAMMAR.md's "Router-outlet
' transitions" and findings/router-transitions.md.
'
' Same narrated-chapter pattern as apps/animation-demo's own OutletTransitionsDemo.thr: nothing this
' chapter's own template can trigger that the others haven't already shown, since the transition
' isn't per-route.
'
' The one contrast this app can actually demonstrate, explicitly: MainScene.thr's own REWIND/
' FAST-FORWARD handlers BOTH call router.navigate() (never router.back()) — see that file's own top
' comment — so both directions of chapter-advance play the SAME navigate-out:/navigate-in: pair
' (slide left/enter from right). back-out:/back-in: (slide right/enter from left) are the exact
' OPPOSITE pair, and the ONLY thing in this whole app that ever plays them is the genuine physical
' Back key — the automatic router.back() fallthrough, walking real chapter history. Press physical
' Back now (not REWIND) to see it: this screen slides out to the right while the previous chapter
' re-enters from the left, visibly different from every REWIND/FAST-FORWARD switch you've been
' watching.
scale field rootWidth: integer = 1280
scale field rootHeight: integer = 720
scale state titleTranslation: object = [40, 30]
scale state subtitleTranslation: object = [40, 80]
scale field cardWidth: integer = 1100
scale field cardHeight: integer = 420
scale state cardTranslation: object = [90, 220]
scale state cardLabelTranslation: object = [40, 40]

public function setup() {
  router.markReady()
}
</script>

<component>
<Rectangle id="root" color="0x151515FF" width="{rootWidth}" height="{rootHeight}">
  <Label id="title" text="3/4 -- router-outlet transitions" color="0xFFFFFFFF" translation="{titleTranslation}" />
  <Label id="subtitle" text="Every chapter switch you've just been watching IS this mechanism" color="0xAAAAAAFF" translation="{subtitleTranslation}" />
  <Rectangle id="card" focusable="true" default-focus="true" color="0x2A2A6AFF" width="{cardWidth}" height="{cardHeight}" translation="{cardTranslation}">
    <Label id="cardLabel" text="MainScene.thr's router outlet carries navigate-out/navigate-in/back-out/back-in, each naming a script-declared animation targeting the outlet itself. REWIND and FAST-FORWARD both call router.navigate() -- so both play navigate-out/navigate-in (slide left, enter from right), the SAME pair every time. Only the physical Back key ever plays back-out/back-in (slide right, enter from left) -- try it now." color="0xFFFFFFFF" translation="{cardLabelTranslation}" wrap="true" width="{cardWidth - 80}" />
  </Rectangle>
</Rectangle>
</component>
