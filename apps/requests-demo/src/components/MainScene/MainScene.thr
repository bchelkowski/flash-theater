<script>
' This app's root Scene, compiled from .thr (like apps/animation-demo's/apps/focus-demo's own
' MainScene — see findings/demo-app-conventions.md for why every apps/*-demo app now uses
' `router`+`scale` instead of a hand-rolled {#if:destroy}/manual-focus-claim switch). Router-mounted
' chapters, one per request Http {} mechanism from site/src/pages/docs/requests.astro. Split off
' apps/async-demo (see findings/requests-demo-app.md) — this app covers ONLY the requests doc-nav
' topic; taskManager's own interceptor/alerting/priority-queue chapters live in the separate
' apps/task-manager-demo, and Timer statements in apps/timers-demo.
'
' None of this app's chapters declare their own `startDemo()` — every button is purely
' key-triggered, so unlike apps/async-demo's old MainScene.thr, there's no forwarding/dispatch
' logic needed here beyond the router skeleton itself.
scale field rootWidth: integer = 1920
scale field rootHeight: integer = 1080
scale state hintTranslation: object = [40, 1020]

field chapterPaths: array = [
  "declare-call", "caching", "build-safety", "parse-safety"
]
state activeChapterIndex: integer = 0

derived hintText: string = "Chapter " + (activeChapterIndex + 1).ToStr() + "/4 — REWIND / FAST-FORWARD to switch, BACK to return"

private function nextChapter(key: string, press: boolean) {
  if (press and activeChapterIndex < chapterPaths.Count() - 1) {
    state activeChapterIndex = activeChapterIndex + 1
    router.navigate("/" + chapterPaths[activeChapterIndex])
  }
}

private function prevChapter(key: string, press: boolean) {
  if (press and activeChapterIndex > 0) {
    state activeChapterIndex = activeChapterIndex - 1
    router.navigate("/" + chapterPaths[activeChapterIndex])
  }
}

public function setup() {
  router.setRouting([
    { path: "declare-call", component: "DeclareCallDemo" },
    { path: "caching", component: "CachingDemo" },
    { path: "build-safety", component: "BuildRequestSafetyDemo" },
    { path: "parse-safety", component: "ParseSafetyDemo" }
  ])
  router.navigate("/" + chapterPaths[0])
}
</script>

<component extends="Scene" on:key[fastforward]="{nextChapter()}" on:key[rewind]="{prevChapter()}">
<Rectangle id="root" color="0x101010FF" width="{rootWidth}" height="{rootHeight}">
  <FlashTheaterRouterOutlet id="outlet" width="{rootWidth}" height="{rootHeight}" />
  <Label id="hint" text="{hintText}" color="0x888888FF" translation="{hintTranslation}" />
</Rectangle>
</component>
