<script>
' Chapter 3/4 — GRAMMAR.md's "Requests" → "Build safety": a `buildRequest` hook that throws no
' longer crashes the calling thread — it degrades to the static base options, and
' `resolvedOptions.buildSucceeded`/`buildErrorMessage` (read directly here via
' `task.resolvedOptions`, right after `prepareRequest` returns — a plain, ordinary field read, no
' interceptor needed for a LOCAL look at the one request this screen itself just sent) report what
' happened. Migrated as-is (in shape) from apps/async-demo's own BuildRequestSafetyDemo.thr — see
' findings/requests-demo-app.md for the split. The cross-component `taskManager.onRequestSent(...)`
' reporting story (a persistent readout in the old async-demo's MainScene.thr) now belongs to
' apps/task-manager-demo, not here — this chapter demonstrates only the request-safety mechanic
' itself, default (OK — buildRequest succeeds) alongside customized (Replay — buildRequest throws).
scale field rootWidth: integer = 1920
scale field rootHeight: integer = 1080
scale field buttonWidth: integer = 420
scale field buttonHeight: integer = 70
scale state titleTranslation: object = [40, 40]
scale state subtitleTranslation: object = [40, 90]
scale state okButtonTranslation: object = [40, 160]
scale state brokenButtonTranslation: object = [40, 250]
scale state buildStatusTranslation: object = [40, 360]
scale state resultTranslation: object = [40, 400]
scale state buttonLabelInset: object = [20, 22]

state buildStatusText: string = "(not sent yet)"
state resultText: string = "(not sent yet)"

private function sendRequest(simulateFailure: boolean) {
  task = CreateObject("roSGNode", "SafeBuildRequest")
  task.callFunc("prepareRequest", { userId: "1", simulateFailure: simulateFailure })

  if (task.resolvedOptions.buildSucceeded) {
    state buildStatusText = "buildRequest: OK"
  } else {
    state buildStatusText = "buildRequest: FAILED - " + task.resolvedOptions.buildErrorMessage
  }

  taskManager.run(task)
  taskManager.onResult(task, onRequestSucceeded, onRequestFailed)
}

private function sendOk(key: string, press: boolean) {
  if (press) {
    sendRequest(false)
  }
}

private function sendBroken(key: string, press: boolean) {
  if (press) {
    sendRequest(true)
  }
}

private function onRequestSucceeded(result: dynamic) {
  state resultText = "Loaded " + result.count.ToStr() + " posts — the request still completed"
}

private function onRequestFailed(error: dynamic) {
  state resultText = "Request itself failed: " + error.message
}
</script>

<component>
<Rectangle id="root" color="0x151515FF" width="{rootWidth}" height="{rootHeight}">
  <Label id="title" text="3/4 — buildRequest safety (a throwing hook never crashes the caller)" color="0xFFFFFFFF" translation="{titleTranslation}" />
  <Label id="subtitle" text="Up/Down to pick a button, OK to send it — top: default (buildRequest OK), bottom: customized (buildRequest throws)" color="0xAAAAAAFF" translation="{subtitleTranslation}" />
  <Rectangle id="okButton" focusable="true" default-focus="true" color="0x2A2A2AFF" width="{buttonWidth}" height="{buttonHeight}" translation="{okButtonTranslation}" on:key[OK]="{sendOk()}">
    <Label id="okButtonLabel" text="Send (buildRequest OK)" color="0xFFFFFFFF" translation="{buttonLabelInset}" />
  </Rectangle>
  <Rectangle id="brokenButton" focusable="true" color="0x2A2A2AFF" width="{buttonWidth}" height="{buttonHeight}" translation="{brokenButtonTranslation}" on:key[OK]="{sendBroken()}">
    <Label id="brokenButtonLabel" text="Send (buildRequest throws)" color="0xFFFFFFFF" translation="{buttonLabelInset}" />
  </Rectangle>
  <Label id="buildStatusReadout" text="{buildStatusText}" color="0x66CCFFFF" translation="{buildStatusTranslation}" />
  <Label id="resultReadout" text="{resultText}" color="0x66FF99FF" translation="{resultTranslation}" />
</Rectangle>
</component>
